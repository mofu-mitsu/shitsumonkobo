{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/ogp-image",
      "destination": "/api/ogp-image"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "id"
        }
      ],
      "destination": "/api/render"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
