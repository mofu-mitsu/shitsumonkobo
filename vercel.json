{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/ogp/:id.png",
      "destination": "/api/ogp-image.ts?id=$1"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "id"
        }
      ],
      "destination": "/api/render.ts"
    },
    {
      "source": "/((?!assets/|api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
